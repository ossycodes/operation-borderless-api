# Copy to .env for running the API on the host (`yarn start:dev`).
# `docker compose up` does not need this file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://harmattan:harmattan@localhost:5433/harmattan
REDIS_URL=redis://localhost:6380
DB_RUN_MIGRATIONS=true

# live = public FX API with fallbacks, static = fixed rate table
FX_PROVIDER=live
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_HTTP_TIMEOUT_MS=3000
FX_CACHE_TTL_SECONDS=300
FX_REFRESH_INTERVAL_SECONDS=300
FX_REFRESH_JOB_ENABLED=true
