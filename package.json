{
  "name": "harmattan-api",
  "version": "0.0.1",
  "description": "Harmattan: a stablecoin-powered cross-border payments & FX sandbox API",
  "author": "Osaigbovo Emmanuel",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects e2e",
    "openapi:export": "nest build && node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "projects": [
      {
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node",
        "displayName": "unit",
        "rootDir": ".",
        "roots": [
          "<rootDir>/src"
        ],
        "testRegex": "\\.spec\\.ts$"
      },
      {
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node",
        "displayName": "e2e",
        "rootDir": ".",
        "roots": [
          "<rootDir>/test"
        ],
        "testRegex": "\\.e2e-spec\\.ts$",
        "globalSetup": "<rootDir>/test/setup/global-setup.ts",
        "globalTeardown": "<rootDir>/test/setup/global-teardown.ts",
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup/jest.setup.ts"
        ]
      }
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/main.ts",
      "!src/database/migrations/**"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22"
}
